# 오브젝트 스토리지(MinIO) 자격 — 실제 값은 .env 에 (git 추적 안 됨)
# 채우는 법: python3 engine/scripts/init.py 가 물어보고 대신 써 줍니다.
#
# ⚠️ 이 파일에는 절대 실제 키를 적지 마세요. 여기는 "변수 이름"만 사는 곳입니다.
#
# 🔴 손으로 .env 를 채운다면 값을 **작은따옴표로 감싸세요** — 예: S3_SECRET_ACCESS_KEY='se$cr et'
#    공백·$·백틱이 든 값을 안 감싸면, 셸로 읽는 도구와 값이 달라져 조용히 어긋납니다.

S3_ENDPOINT_URL=            # not-a-secret: 내 홈서버 MinIO 주소 (예 http://localhost:9000)
S3_BUCKET=                  # not-a-secret: 버킷 이름 (예 my-wiki)
S3_ACCESS_KEY_ID=           # not-a-secret: 빈 템플릿. 실제 값은 .env 에만
S3_SECRET_ACCESS_KEY=       # not-a-secret: 빈 템플릿. 실제 값은 .env 에만

# 선택 — 대부분 건드릴 일 없습니다
# AWS_REGION=us-east-1
